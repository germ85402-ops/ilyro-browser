{
  "manifest_version": 2,
  "name": "ILYRO Media Detector",
  "version": "1.0.8",
  "applications": {
    "gecko": {
      "id": "media-detector@ilyro"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "detector.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "<all_urls>"
  ]
}
