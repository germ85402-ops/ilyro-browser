{
  "manifest_version": 2,
  "name": "ILYRO Media Fullscreen Fix",
  "version": "1.8.3",
  "applications": {
    "gecko": {
      "id": "media-fullscreen@ilyro"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fullscreen.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "gesture-policy.js",
        "gestures.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
